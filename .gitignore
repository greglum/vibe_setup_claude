# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
*.pyo

# Node / React
node_modules/
*.tsbuildinfo

# Build output (generated by pnpm run build)
portals/

# Environment files (credentials — never commit)
.env
.env.local
.env.dev
.env.prod
.env.*.local

# Temporary files and backups
temp/

# Screenshots — keep the directory + README, ignore the actual captures.
# Use `screenshots/*` (not `screenshots/`) so the negation below can re-include
# the README; git can't un-ignore files inside an ignored directory.
screenshots/*
!screenshots/README.md

# IDE
.vscode/
.idea/

# Note: .mcp.json is tracked because it uses ${env:VAR} references, not secrets.
# If you replace env vars with literal credentials, uncomment the next line:
# .mcp.json
